{
  "apiVersion": 1,
  "requires": {
    "pluginApi": "3.7.0"
  },
  "id": "eidos.chart",
  "name": "%plugin.name%",
  "version": "0.4.0",
  "icon": {
    "paths": [
      "M3 3v18h18",
      "M7 16v-5",
      "M12 16V7",
      "M17 16v-8"
    ]
  },
  "views": [
    {
      "id": "chart",
      "title": "%views.chart.title%",
      "entry": "./src/view.tsx",
      "access": "read",
      "icon": {
        "paths": [
          "M3 3v16a2 2 0 0 0 2 2h16",
          "m19 9-5 5-4-4-3 3"
        ]
      },
      "configuration": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "title": "%views.chart.type.title%",
            "default": "Column",
            "enum": [
              "Column",
              "Bar",
              "Line",
              "Donut",
              "Number"
            ]
          },
          "group": {
            "type": "string",
            "title": "%views.chart.group.title%",
            "default": "",
            "x-field": true
          },
          "value": {
            "type": "string",
            "title": "%views.chart.value.title%",
            "default": "",
            "x-field": true,
            "description": "%views.chart.value.description%"
          },
          "aggregate": {
            "type": "string",
            "title": "%views.chart.aggregate.title%",
            "default": "Count",
            "enum": [
              "Count",
              "Sum",
              "Average",
              "Minimum",
              "Maximum"
            ]
          },
          "date": {
            "type": "string",
            "title": "%views.chart.date.title%",
            "default": "Exact",
            "enum": [
              "Exact",
              "Day",
              "Month",
              "Year"
            ]
          },
          "sort": {
            "type": "string",
            "title": "%views.chart.sort.title%",
            "default": "Label",
            "enum": [
              "Label",
              "Value descending",
              "Value ascending"
            ]
          },
          "legend": {
            "type": "boolean",
            "title": "%views.chart.legend.title%",
            "default": true
          }
        }
      },
      "kind": "file",
      "capabilities": [
        "eidos/table"
      ]
    }
  ],
  "placements": [
    {
      "location": "table/view",
      "view": "chart"
    }
  ],
  "description": "%plugin.description%",
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
